# Copy to .env (or set the same names in Dokploy's environment panel).
# .env is git-ignored and never shipped in the image.

# Required. The evaluation service API key. Server-side only: it is never sent to
# the browser and never logged. Get one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Every value below has a safe default; see src/config.ts.
# ---------------------------------------------------------------------------

# Model alias sent with each request. Blank uses the service default.
TYPESAFE_MODEL=

# Port and bind address. Dokploy routes to PORT over the container network.
PORT=3000
HOST=0.0.0.0

# Set to production when deployed. Development mode enables extra diagnostics.
NODE_ENV=production

# Trust the reverse proxy's client address headers (x-forwarded-for,
# cf-connecting-ip). Keep at 1 only when a trusted proxy sits directly in front of
# this container, which Dokploy's Traefik does. Set to 0 if the container port is
# exposed directly, so the socket address is used instead.
TRUST_PROXY=1

# Spend guards. 0 disables any individual limit.
RATE_LIMIT_PER_MINUTE=4
RATE_LIMIT_PER_DAY=30
GLOBAL_DAILY_LIMIT=300
RATE_LIMIT_MAX_CLIENTS=20000

# Input and upstream guards.
MAX_WORDS=1200
MAX_PROMPT_CHARS=2000
MAX_BODY_BYTES=65536
UPSTREAM_TIMEOUT_MS=20000
MINIMUM_WORDS=250

# Operations.
LOG_REQUESTS=1
PUBLIC_DIAGNOSTICS=1